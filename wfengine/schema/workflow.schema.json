{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/json-workflow.schema.json",
  "title": "JSON Workflow Definition",
  "description": "Structural schema. Semantic rules (cycles, missing dependencies, references to non-ancestor steps, unique ids) are enforced by wfengine.validation, which is the source of truth.",
  "type": "object",
  "required": ["workflow_id", "steps"],
  "additionalProperties": false,
  "properties": {
    "workflow_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$", "description": "Business key. Also the Temporal workflow id: submitting the same id twice never executes twice." },
    "version": { "type": ["string", "integer"], "description": "Free-form definition version, stored in the workflow memo." },
    "description": { "type": "string" },
    "input": { "type": "object", "description": "Workflow-level input, reachable as ${input.<path>}." },
    "failure_policy": { "enum": ["fail_fast", "wait_all"], "default": "fail_fast", "description": "fail_fast: a fatal step failure cancels in-flight siblings. wait_all: siblings finish, then the workflow fails with partial results." },
    "task_queue": { "$ref": "#/$defs/queue" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "retry": { "$ref": "#/$defs/retry" }, "timeouts": { "$ref": "#/$defs/timeouts" }, "task_queue": { "$ref": "#/$defs/queue" } }
    },
    "steps": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "queue": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initial_interval_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "backoff_coefficient": { "type": "number", "minimum": 1 },
        "maximum_interval_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_attempts": { "type": "integer", "minimum": 0, "description": "0 = unlimited. Engine default is 3." },
        "non_retryable_error_types": { "type": "array", "items": { "type": "string" } }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_to_close_seconds": { "type": "number", "exclusiveMinimum": 0, "description": "Per attempt. Default 60." },
        "schedule_to_close_seconds": { "type": "number", "exclusiveMinimum": 0, "description": "Across all attempts." },
        "heartbeat_seconds": { "type": "number", "exclusiveMinimum": 0, "description": "Dead-worker detection. Default 30." }
      }
    },
    "condition": {
      "oneOf": [
        { "type": "object", "required": ["all"], "additionalProperties": false, "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "required": ["any"], "additionalProperties": false, "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "required": ["not"], "additionalProperties": false, "properties": { "not": { "$ref": "#/$defs/condition" } } },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "step": { "type": "string" },
            "input": { "type": "string" },
            "field": { "enum": ["output", "status"], "default": "output" },
            "path": { "type": "string" },
            "op": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "contains", "exists", "truthy"] },
            "value": {}
          },
          "oneOf": [{ "required": ["step"] }, { "required": ["input"] }]
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "type": { "enum": ["activity", "wait_signal", "delay"] },
        "name": { "type": "string", "description": "activity: operation to execute." },
        "description": { "type": "string" },
        "input": { "type": "object", "description": "May contain ${steps.<id>.output.<path>} and ${input.<path>}. If omitted, the operation receives {upstream: {<dep>: <output>}, workflow_input}." },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "condition": { "$ref": "#/$defs/condition" },
        "retry": { "$ref": "#/$defs/retry" },
        "timeouts": { "$ref": "#/$defs/timeouts" },
        "on_failure": { "enum": ["fail", "continue"], "default": "fail" },
        "trigger_rule": { "enum": ["all_success", "all_done"], "default": "all_success" },
        "task_queue": { "$ref": "#/$defs/queue" },
        "signal": { "type": "string", "description": "wait_signal: event name to wait for." },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "description": "wait_signal: omit to wait indefinitely." },
        "seconds": { "type": "number", "minimum": 0, "description": "delay: durable timer length." }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "activity" } } }, "then": { "required": ["name"] } },
        { "if": { "properties": { "type": { "const": "wait_signal" } } }, "then": { "required": ["signal"] } },
        { "if": { "properties": { "type": { "const": "delay" } } }, "then": { "required": ["seconds"] } }
      ]
    }
  }
}
